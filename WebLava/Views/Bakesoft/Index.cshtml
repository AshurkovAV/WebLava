@using WebLava.Models.Bakesoft
@using WebLava.Models.Crm
@{
    Layout = "~/Views/CrmLanding/_CrmLayout.cshtml";
    ViewData["Title"] = "Bakesoft — система учёта заказов и производства для кондитерской | Big Lava";
    ViewData["Description"] = "Bakesoft — программа для кондитерской и студии тортов: заказы, техкарты с пересчётом под размер, себестоимость, план производства и закупки. 14 дней бесплатно.";
    ViewData["Keywords"] = "программа для кондитерской, учёт заказов тортов, система для кондитерской, программа для кондитера, техкарты тортов, пересчёт рецепта под размер, себестоимость торта, план производства кондитерской, Bakesoft";
    ViewData["OgImage"] = "https://biglv.ru/images/post/og-bakesoft.jpg";
    ViewData["BrandTag"] = "Bakesoft";
    ViewData["BrandHref"] = "/bakesoft";
    ViewData["BrandLabel"] = "Bakesoft — на страницу продукта";
    ViewData["HeaderCtaHref"] = BakesoftPricing.RegisterUrl;
    ViewData["FooterText"] = "Bakesoft — продукт студии Big Lava: система управления заказами и производством для кондитерских. Студия разрабатывает мобильные приложения и ИТ-решения для бизнеса.";

    const string pageUrl = "https://biglv.ru/bakesoft";
    var minPlan = BakesoftPricing.Plans.First();

    var faq = new List<CrmFaqItem>
    {
        new("Чем Bakesoft отличается от CRM?",
            "CRM ведёт клиентов и сделки. Bakesoft ведёт заказ дальше: пересчитывает рецептуру под размер торта, считает себестоимость и цену, собирает план производства и список закупки, а в день выдачи показывает, что и кому отдать. Это система для кондитерской на заказ, а не для отдела продаж."),
        new("Сколько человек может работать в системе?",
            "Зависит от тарифа: " + string.Join("; ", BakesoftPricing.Plans.Select(p => $"«{p.Name}» — {char.ToLowerInvariant(p.Users[0])}{p.Users[1..]}")) + ". Владелец входит в это число. Функции во всех тарифах одинаковые."),
        new("Можно работать с телефона?",
            "Да. Bakesoft открывается в браузере на телефоне, планшете и компьютере, его можно добавить на главный экран как приложение. Принять заказ, посмотреть, что сегодня к выдаче, и отметить выдачу можно прямо с телефона."),
        new("Можно перенести мои рецепты из Excel?",
            "Да. Пришлите файл с техкартами из Excel или Google Таблиц, и мы поможем их перенести. Для быстрого старта в системе есть шесть базовых рецептов, которые можно импортировать и поправить под себя."),
        new("Как оплатить подписку и как её отменить?",
            $"Первые {BakesoftPricing.TrialDays} дней бесплатно. Дальше подписка оплачивается на месяц, 6 месяцев или год по СБП или банковской картой в разделе «Настройки → Подписка». Автопродление отключается в один клик, доступ сохраняется до конца оплаченного периода."),
        new("Насколько безопасны мои данные?",
            "Рецепты, заказы и база клиентов видны только вам и сотрудникам, которым вы дали доступ. Данные каждой кондитерской изолированы, соединение шифруется (HTTPS), вход — по паролю или через Яндекс ID."),
    };
}

@section Head {
    <link rel="preload" as="image" href="/images/bakesoft/order-recipe.jpg">
    <script type="application/ld+json">@Html.Raw(CrmSchema.SoftwareApplication(
        "Bakesoft",
        (string)ViewData["Description"]!,
        pageUrl,
        "https://biglv.ru/images/post/og-bakesoft.jpg",
        BakesoftPricing.Plans.Select(p => (p.Name, p.PriceMonth)),
        BakesoftPricing.Currency))</script>
    <style>
        .pg-bs-chain { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 22px; padding: 0; list-style: none; }
        .pg-bs-chain li { font-size: 14px; font-weight: 600; padding: 8px 14px; border-radius: 999px; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.12); }
        .pg-bs-chain li + li::before { content: "→"; margin-right: 8px; opacity: .55; }
        .crm-window img, .crm-phone img { display: block; width: 100%; height: auto; }
        .pg-bs-periods { margin: 6px 0 0; font-size: 14px; line-height: 1.6; opacity: .75; }
        .pg-bs-common { margin-top: 28px; text-align: center; opacity: .85; }
        .pg-bs-site { margin-top: 18px; font-size: 15px; opacity: .8; }
        .pg-bs-site a { color: inherit; }
        .crm-hero__text h1.pg-bs-h1 { font-size: clamp(32px, 3.6vw, 50px); line-height: 1.12; }
        .pg-bs-h1 span { display: block; }
        @@media (max-width: 480px) { .crm-brand__tag { display: none; } }
    </style>
}

<!-- Hero -->
<section class="crm-hero" aria-labelledby="hero-title">
    <div class="crm-wrap crm-hero__grid">
        <div class="crm-hero__text">
            <span class="crm-chip"><span class="crm-chip__dot" aria-hidden="true"></span>Продукт студии Big Lava</span>
            <h1 id="hero-title" class="pg-bs-h1"><span>Bakesoft —</span> система управления заказами и производством для кондитерских</h1>
            <p class="crm-hero__sub">Приняли заказ — система сама посчитала, что приготовить и что купить. Для кондитеров на заказ, кондитерских и студий тортов. С телефона и компьютера.</p>
            <ol class="pg-bs-chain" aria-label="Как проходит заказ">
                <li>Заказ</li><li>Пересчёт рецептуры</li><li>План производства</li><li>Закупка</li><li>Выдача</li>
            </ol>
            <div class="crm-hero__cta">
                <a class="crm-btn crm-btn--primary" href="@BakesoftPricing.RegisterUrl">Попробовать @BakesoftPricing.TrialDays дней бесплатно</a>
                <a class="crm-btn crm-btn--ghost" href="#features">Смотреть, как работает</a>
            </div>
            <p class="crm-hero__meta">от @BakesoftPlan.Format(minPlan.PriceMonth) ₽/мес · без карты на пробный период · оплата по СБП</p>
        </div>
        <div class="crm-hero__visual">
            <div class="crm-window">
                <img src="/images/bakesoft/order-recipe.jpg" alt="Bakesoft: новый заказ по техкарте — торт «Медовик» пересчитан с Ø20 на Ø22 (×1,21), остатки склада по ингредиентам, себестоимость 2 633 ₽ и цена для клиента 4 600 ₽" width="1440" height="900" fetchpriority="high">
            </div>
            <div class="crm-phone">
                <img src="/images/bakesoft/today-mobile.jpg" alt="Bakesoft на телефоне: «Сегодня к выдаче» — заказы по времени, сумма к доплате и кнопка «Выдан»" width="780" height="1688">
            </div>
        </div>
    </div>
</section>

<!-- Pains -->
<section class="crm-section" aria-labelledby="pains-title">
    <div class="crm-wrap">
        <div class="crm-head">
            <p class="crm-eyebrow">Знакомо?</p>
            <h2 id="pains-title">Когда заказов больше десятка в неделю, блокнот перестаёт справляться</h2>
        </div>
        <div class="crm-cards">
            <article class="crm-card">
                <span class="crm-card__icon"><partial name="~/Views/CrmLanding/_CrmIcon.cshtml" model='"notebook"' /></span>
                <h3>Заказы в мессенджерах и блокноте</h3>
                <p>Легко перепутать дату выдачи, диаметр или надпись на торте — особенно в пятницу вечером.</p>
            </article>
            <article class="crm-card">
                <span class="crm-card__icon"><partial name="~/Views/CrmLanding/_CrmIcon.cshtml" model='"scale"' /></span>
                <h3>Пересчёт рецепта под размер</h3>
                <p>Клиент хочет Ø22 вместо Ø20 и два яруса — снова калькулятор, граммы и риск ошибиться.</p>
            </article>
            <article class="crm-card">
                <span class="crm-card__icon"><partial name="~/Views/CrmLanding/_CrmIcon.cshtml" model='"ruble"' /></span>
                <h3>Непонятная себестоимость</h3>
                <p>Масло и сливки дорожают, а цена торта остаётся прежней. Сколько вы на самом деле зарабатываете с заказа?</p>
            </article>
            <article class="crm-card">
                <span class="crm-card__icon"><partial name="~/Views/CrmLanding/_CrmIcon.cshtml" model='"cart"' /></span>
                <h3>Что купить и когда выдать</h3>
                <p>Список закупки собирается вручную, а утром выясняется, что сливок не хватает к заказу на 13:30.</p>
            </article>
        </div>
    </div>
</section>

<!-- Features -->
<section class="crm-section crm-section--alt" id="features" aria-labelledby="features-title">
    <div class="crm-wrap">
        <div class="crm-head">
            <p class="crm-eyebrow">Как работает</p>
            <h2 id="features-title">От заказа до выдачи — в одной системе</h2>
        </div>

        <div class="crm-feature">
            <div class="crm-feature__media crm-window">
                <img src="/images/bakesoft/orders.jpg" alt="Заказы на неделю в Bakesoft: карточки тортов и капкейков по дням со временем выдачи, клиентом, надписью, статусом и оплатой" width="1440" height="900" loading="lazy" decoding="async">
            </div>
            <div class="crm-feature__text">
                <h3>Все заказы недели на одной доске</h3>
                <p>Карточки по дням: время выдачи, изделие с диаметром и весом, клиент, надпись и статус оплаты. Сверху — сколько выдаём сегодня, сколько в работе и сколько денег к получению.</p>
                <ul class="crm-checks">
                    <li>Статусы: черновик, принят, в работе, готов, выдан</li>
                    <li>Надпись на торте и декор не потеряются</li>
                    <li>Предоплата и доплата видны сразу</li>
                </ul>
            </div>
        </div>

        <div class="crm-feature crm-feature--rev">
            <div class="crm-feature__media crm-window">
                <img src="/images/bakesoft/order-recipe.jpg" alt="Техкарта торта «Медовик» с автопересчётом с Ø20 на Ø22, формулой рядом с каждой граммовкой, остатками склада и расчётом себестоимости, наценки и цены" width="1440" height="900" loading="lazy" decoding="async">
            </div>
            <div class="crm-feature__text">
                <h3>Техкарты с пересчётом под размер</h3>
                <p>Выберите рецепт, диаметр и количество ярусов — граммы пересчитаются сами. Рядом с каждым числом видна формула, например 430 × 1,21 = 520 г.</p>
                <ul class="crm-checks">
                    <li>Сразу видно, хватает ли ингредиентов на складе</li>
                    <li>Себестоимость: ингредиенты, работа, упаковка и декор</li>
                    <li>Цена с вашей наценкой, прибыль, маржа и предоплата</li>
                </ul>
            </div>
        </div>

        <div class="crm-feature">
            <div class="crm-feature__media crm-window">
                <img src="/images/bakesoft/production.jpg" alt="План производства на сегодня: этапы выпечки, кремов, сборки и декора с заказами, временем, исполнителями и загрузкой кондитеров" width="1440" height="900" loading="lazy" decoding="async">
            </div>
            <div class="crm-feature__text">
                <h3>План производства на сегодня и завтра</h3>
                <p>План собирается из техкарт заказов обратным счётом от времени выдачи: какие коржи печь, какой крем готовить, что собирать и украшать.</p>
                <ul class="crm-checks">
                    <li>Этапы по времени с исполнителями и длительностью</li>
                    <li>Загрузка каждого кондитера на день</li>
                    <li>Печать техкарт для цеха</li>
                </ul>
            </div>
        </div>

        <div class="crm-feature crm-feature--rev">
            <div class="crm-feature__media crm-window">
                <img src="/images/bakesoft/purchases.jpg" alt="Список закупки на завтра: ингредиенты с артикулами, сколько нужно, сколько на складе, упаковки и итог по артикулам" width="1440" height="900" loading="lazy" decoding="async">
            </div>
            <div class="crm-feature__text">
                <h3>Склад и список закупки</h3>
                <p>Список закупки = ингредиенты заказов минус остатки склада и уже заказанное плюс страховой запас. Сразу в целых упаковках и с артикулами поставщика.</p>
                <ul class="crm-checks">
                    <li>Остатки, приход и инвентаризация</li>
                    <li>Подсказка «заканчивается на складе»</li>
                    <li>Скоро: отправка заказа в магазин-партнёр с доставкой</li>
                </ul>
            </div>
        </div>

        <div class="crm-feature crm-feature--phone">
            <div class="crm-feature__media">
                <div class="crm-phone crm-phone--static">
                    <img src="/images/bakesoft/today-mobile.jpg" alt="Экран «Сегодня к выдаче» в Bakesoft на телефоне" width="780" height="1688" loading="lazy" decoding="async">
                </div>
            </div>
            <div class="crm-feature__text">
                <h3>Выдача и команда — с телефона</h3>
                <p>Экран «Сегодня к выдаче»: заказы по времени, звонок клиенту и большая кнопка «Выдан», которая фиксирует время и доплату.</p>
                <ul class="crm-checks">
                    <li>Роли: владелец, администратор, кондитер, выдача</li>
                    <li>Уведомления в MAX: заказы на завтра, нехватка на складе, скорая выдача</li>
                    <li>Вход по паролю или через Яндекс ID</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<!-- Steps -->
<section class="crm-section" aria-labelledby="steps-title">
    <div class="crm-wrap">
        <div class="crm-head">
            <p class="crm-eyebrow">Как начать</p>
            <h2 id="steps-title">Три шага до первого заказа в системе</h2>
        </div>
        <ol class="crm-steps">
            <li class="crm-step">
                <h3>Зарегистрируйтесь</h3>
                <p>@BakesoftPricing.TrialDays дней бесплатно, карта не нужна. Можно войти через Яндекс ID.</p>
            </li>
            <li class="crm-step">
                <h3>Добавьте рецепты и склад</h3>
                <p>Импортируйте базовые рецепты или заведите свои, укажите остатки и пригласите сотрудников.</p>
            </li>
            <li class="crm-step">
                <h3>Принимайте заказы</h3>
                <p>Себестоимость, план производства и список закупки соберутся из заказов автоматически.</p>
            </li>
        </ol>
    </div>
</section>

<!-- Pricing -->
<section class="crm-section crm-section--alt" id="pricing" aria-labelledby="pricing-title">
    <div class="crm-wrap">
        <div class="crm-head">
            <p class="crm-eyebrow">Тарифы</p>
            <h2 id="pricing-title">Функции одинаковые во всех тарифах — отличается число сотрудников</h2>
            <p class="crm-lead">Первые @BakesoftPricing.TrialDays дней бесплатно. Оплата за месяц, 6 месяцев или год — за полгода и год дешевле.</p>
            <div class="crm-pay">
                <span class="crm-sbp" aria-label="Оплата по СБП — Системе быстрых платежей"><span class="crm-sbp__mark" aria-hidden="true">СБП</span> Оплата по СБП или картой</span>
            </div>
        </div>
        <div class="crm-plans">
            @foreach (var plan in BakesoftPricing.Plans)
            {
                <article class="crm-plan@(plan.Highlighted ? " crm-plan--hl" : "")" aria-labelledby="plan-@plan.Id">
                    @if (plan.Highlighted)
                    {
                        <span class="crm-plan__badge">Популярный</span>
                    }
                    <h3 id="plan-@plan.Id" class="crm-plan__name">@plan.Name</h3>
                    <p class="crm-plan__summary">@plan.Audience</p>
                    <p class="crm-plan__price"><span class="crm-plan__num">@BakesoftPlan.Format(plan.PriceMonth)&nbsp;₽</span><span class="crm-plan__per">/мес</span></p>
                    <p class="pg-bs-periods">6 месяцев — @BakesoftPlan.Format(plan.Price6Months)&nbsp;₽<br>Год — @BakesoftPlan.Format(plan.Price12Months)&nbsp;₽ (выгода @plan.YearSavingPercent%)</p>
                    <ul class="crm-checks crm-plan__list">
                        <li>@plan.Users</li>
                    </ul>
                    <a class="crm-btn @(plan.Highlighted ? "crm-btn--primary" : "crm-btn--ghost") crm-btn--block" href="@BakesoftPricing.RegisterUrl">Начать с «@plan.Name»</a>
                </article>
            }
        </div>
        <p class="pg-bs-common">Во всех тарифах: @string.Join(" · ", BakesoftPricing.CommonFeatures.Select(f => char.ToLowerInvariant(f[0]) + f[1..])).</p>
    </div>
</section>

<partial name="~/Views/CrmLanding/_CrmFaq.cshtml" model="faq" />

<!-- CTA -->
<section class="crm-section" id="lead" aria-labelledby="cta-title">
    <div class="crm-wrap crm-wrap--narrow" style="text-align:center">
        <div class="crm-head">
            <p class="crm-eyebrow">Начать</p>
            <h2 id="cta-title">Попробуйте Bakesoft на своих заказах</h2>
            <p class="crm-lead">@BakesoftPricing.TrialDays дней бесплатно, без карты. Если нужна помощь с переносом рецептов или настройкой — напишите нам.</p>
        </div>
        <div class="crm-hero__cta" style="justify-content:center">
            <a class="crm-btn crm-btn--primary" href="@BakesoftPricing.RegisterUrl">Зарегистрироваться</a>
            <a class="crm-btn crm-btn--ghost" href="/contact">Задать вопрос</a>
        </div>
        <p class="pg-bs-site">Сайт продукта — <a href="@BakesoftPricing.SiteUrl">bakesoft.ru</a>, там же бесплатный калькулятор торта.</p>
    </div>
</section>

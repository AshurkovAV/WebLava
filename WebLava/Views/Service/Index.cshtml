                            <span class="mb-0">Главная</span>
                            <figure class="mb-0 arrow"><img src="~/images/button-arrow.png" alt="" class="img-fluid"></figure>
                            <span class="mb-0 box_span">Услуги</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <figure class="banner-circleright mb-0">
        <img src="~/images/banner-circleright.png" class="img-fluid" alt="">
    </figure>
    <figure class="sub-bannerrightlayer mb-0">
        <img src="~/images/sub-bannerrightlayer.png" alt="" class="img-fluid">
    </figure>
</div>


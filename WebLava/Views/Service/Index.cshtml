@{
    ViewData["Title"] = "Услуги по разработке мобильных приложений и IT-решений";
    ViewData["ActivePage"] = "service";
    ViewData["Description"] = "Профессиональная разработка мобильных приложений, UX/UI дизайн, frontend и backend разработка. Создаем IT-решения для вашего бизнеса.";
}

<!-- Semantic main tag for better document structure -->
<main>
    <!-- Header Section with proper heading hierarchy -->
    <header class="sub-banner sub-banner4" role="banner">
        <figure class="sub-bannerleftlayer mb-0" aria-hidden="true">
            <img src="~/images/sub-bannerleftlayer.png" alt="" class="img-fluid" loading="lazy">
        </figure>

        @Html.Partial("Menu")

        <section class="banner-section">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                        <div class="banner_content" data-aos="fade-up">
                            <figure class="service-rightcircle mb-0" aria-hidden="true">
                                <img src="~/images/service-rightcircle.png" alt="" class="img-fluid" loading="lazy">
                            </figure>
                            <h1 class="text-white">Услуги по разработке IT-решений</h1>
                            <p>Разрабатываем мобильные приложения и другие IT-продукты для вашего бизнеса</p>
                            <div class="box" aria-label="Хлебные крошки">
                                <span class="mb-0">Главная</span>
                                <figure class="mb-0 arrow" aria-hidden="true"><img src="~/images/button-arrow.png" alt="" class="img-fluid" loading="lazy"></figure>
                                <span class="mb-0 box_span">Услуги</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <figure class="banner-circleright mb-0" aria-hidden="true">
            <img src="~/images/banner-circleright.png" class="img-fluid" alt="" loading="lazy">
        </figure>
        <figure class="sub-bannerrightlayer mb-0" aria-hidden="true">
            <img src="~/images/sub-bannerrightlayer.png" alt="" class="img-fluid" loading="lazy">
        </figure>
    </header>

    <!-- Services Section with semantic markup -->
    <section class="servicepage-section service-section" itemscope itemtype="https://schema.org/Service">
        <figure class="service-leftlayer mb-0" aria-hidden="true">
            <img src="~/images/service-leftlayer.png" alt="" class="img-fluid" loading="lazy">
        </figure>
        <figure class="service-dotimage mb-0" aria-hidden="true">
            <img src="~/images/service-dotimage.png" alt="" class="img-fluid" loading="lazy">
        </figure>

        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="servicepage_content" data-aos="fade-right">
                        <h2>Наши услуги</h2>
                        <h3>Разработка программного обеспечения на заказ</h3>
                        <p itemprop="description">
                            Мы разрабатываем ИТ-решения для клиентов, хорошо знающих особенности своего бизнеса. Поможем превратить ваши знания в эффективно работающий продукт.
                        </p>
                        <figure class="offer-circleimage mb-0" aria-hidden="true">
                            <img src="~/images/offer-circleimage.png" alt="" class="img-fluid" loading="lazy">
                        </figure>
                    </div>
                </div>
            </div>

            <!-- Services Carousel with proper heading structure -->
            <div class="service_contentbox">
                <div class="row">
                    <div class="owl-carousel owl-theme">
                        <!-- Each service item with microdata -->
                        <div class="item" itemprop="hasOfferCatalog" itemscope itemtype="https://schema.org/OfferCatalog">
                            <div class="service-box box-mb" itemprop="itemListElement" itemscope itemtype="https://schema.org/Offer">
                                <figure class="service-marketicon">
                                    <img src="~/images/service-marketicon.png" alt="Иконка технического задания" class="img-fluid" loading="lazy" itemprop="image">
                                </figure>
                                <h4 itemprop="name">Техническое задание</h4>
                                <p class="text-size-18" itemprop="description">Техническое задание на разработку приложения сэкономит бюджет.</p>
                                <a class="arrow text-decoration-none" href="./technical" itemprop="url"><i class="circle fa-thin fa-arrow-right"></i></a>
                            </div>
                        </div>

                        <div class="item" itemprop="hasOfferCatalog" itemscope itemtype="https://schema.org/OfferCatalog">
                            <div class="service-box box-mb" itemprop="itemListElement" itemscope itemtype="https://schema.org/Offer">
                                <figure class="service-producticon">
                                    <img src="~/images/service-producticon.png" alt="Иконка мобильной разработки" class="img-fluid" loading="lazy" itemprop="image">
                                </figure>
                                <h4 itemprop="name">Мобильная разработка</h4>
                                <p class="text-size-18" itemprop="description">Профессионально создаём мобильные приложения.</p>
                                <a class="arrow text-decoration-none" href="./service" itemprop="url"><i class="circle fa-thin fa-arrow-right"></i></a>
                            </div>
                        </div>

                        <!-- Other service items follow the same pattern -->
                        <!-- ... -->
                    </div>
                </div>
            </div>
        </div>

        <figure class="service-rightlayer mb-0" aria-hidden="true">
            <img src="~/images/service-rightlayer.png" alt="" class="img-fluid" loading="lazy">
        </figure>
    </section>
</main>

<!-- Structured data for better search engine understanding -->
<script type="application/ld+json">
    @Html.Raw(Json.Serialize(new
        {
            context = "https://schema.org",
            type = "ProfessionalService",
            name = "Услуги по разработке IT-решений",
            description = "Профессиональная разработка мобильных приложений, UX/UI дизайн, frontend и backend разработка",
            hasOfferCatalog = new
            {
                type = "OfferCatalog",
                name = "IT Услуги",
                itemListElement = new[]
                    {
                new
                {
                    type = "Offer",
                    itemOffered = new
                    {
                        type = "Service",
                        name = "Техническое задание",
                        description = "Техническое задание на разработку приложения сэкономит бюджет"
                    }
                },
                new
                {
                    type = "Offer",
                    itemOffered = new
                    {
                        type = "Service",
                        name = "Мобильная разработка",
                        description = "Профессионально создаём мобильные приложения"
                    }
                }
            }
            }
        }))
</script>
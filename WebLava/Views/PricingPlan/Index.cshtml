@{
    ViewData["Title"] = "Цены на разработку мобильных приложений | Big Lava";
    ViewData["ActivePage"] = "pricingplan";
    ViewData["Description"] = "Тарифы Big Lava на разработку мобильных приложений: MVP до 500 000 ₽ за 2 мес., каталог до 1,2 млн ₽, маркетплейс от 3 млн ₽. Закажите расчёт.";
}

@section Head {
    <style>
        .pg-price-kind { font-size: 15px; color: var(--ml-muted); margin-top: 6px; }
        .pg-price-term { display: inline-flex; align-items: center; gap: 8px; margin-top: 10px; font-size: 15px; color: var(--ml-muted); }
        .pg-price-term svg { width: 16px; height: 16px; color: var(--ml-accent); flex: none; }
        .ml-price__value { font-size: clamp(34px, 3vw, 46px); white-space: nowrap; }
        .pg-price-factors .ml-row__title { font-size: clamp(22px, 2vw, 30px); }
        .pg-price-factors .ml-row { grid-template-columns: 80px minmax(0, 1fr) minmax(0, 1.2fr); }
        @@media (max-width: 860px) { .pg-price-factors .ml-row { grid-template-columns: 40px 1fr; } .pg-price-factors .ml-row__desc { grid-column: 2 / 3; } }
    </style>
}

<section class="ml-page-hero">
    <div class="ml-container">
        <nav class="ml-breadcrumbs" aria-label="Хлебные крошки">
            <a href="/">Главная</a><span aria-hidden="true">/</span><span>Цены</span>
        </nav>
        <p class="ml-eyebrow">Тарифы</p>
        <h1 class="ml-display" data-reveal>Цены на&nbsp;разработку <span class="ml-gradient-text">приложений</span></h1>
        <p class="ml-lead" data-reveal>
            Технологии, которые окупаются. Три понятных формата — от MVP до маркетплейса: прозрачные цены и сроки.
            Точную стоимость считаем под ваш проект.
        </p>
    </div>
</section>

<section class="ml-section ml-section--tight" style="padding-top:0">
    <div class="ml-container">
        <div class="ml-prices" data-reveal-stagger>
            <div class="ml-price">
                <h2 class="ml-price__name">Простое</h2>
                <p class="pg-price-kind">MVP, визитка</p>
                <div class="ml-price__value">до 500 000 ₽</div>
                <div class="pg-price-term">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                    Срок: до 2 мес.
                </div>
                <ul>
                    <li>Стартовый экран</li>
                    <li>Каталог / Услуги</li>
                    <li>Контакты / О компании</li>
                    <li>Push-уведомления</li>
                    <li>Личный кабинет</li>
                </ul>
                <a class="ml-btn ml-btn--ghost" href="/contact">Заказать расчёт <span class="ml-arrow">→</span></a>
            </div>

            <div class="ml-price ml-price--featured">
                <h2 class="ml-price__name">Среднее</h2>
                <p class="pg-price-kind">Каталог, блог</p>
                <div class="ml-price__value">до 1 200 000 ₽</div>
                <div class="pg-price-term">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                    Срок: 3–6 мес.
                </div>
                <ul>
                    <li>10–20 экранов</li>
                    <li>Поиск, фильтры, комментарии</li>
                    <li>Личный кабинет + админка</li>
                    <li>API + интеграции</li>
                    <li>Push-уведомления</li>
                </ul>
                <a class="ml-btn ml-btn--accent" href="/contact">Заказать расчёт <span class="ml-arrow">→</span></a>
            </div>

            <div class="ml-price">
                <h2 class="ml-price__name">Сложное</h2>
                <p class="pg-price-kind">Маркетплейс, соцсеть</p>
                <div class="ml-price__value">3 000 000+ ₽</div>
                <div class="pg-price-term">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                    Срок: 6–12+ мес.
                </div>
                <ul>
                    <li>20+ экранов с индивидуальным дизайном</li>
                    <li>Платежи и безопасные транзакции</li>
                    <li>Чат, UGC, модерация контента</li>
                    <li>Свой backend и API</li>
                    <li>Поддержка 10k+ пользователей</li>
                </ul>
                <a class="ml-btn ml-btn--ghost" href="/contact">Заказать расчёт <span class="ml-arrow">→</span></a>
            </div>
        </div>
    </div>
</section>

<section class="ml-section ml-section--surface">
    <div class="ml-container">
        <div class="ml-split">
            <div>
                <p class="ml-eyebrow">Из чего складывается цена</p>
                <h2 class="ml-h2">Что влияет на&nbsp;стоимость</h2>
                <p class="ml-lead ml-mt-m">
                    Тариф задаёт порядок цифр. Итоговая сумма зависит от объёма и сложности — её фиксируем после обсуждения задачи.
                </p>
                <a class="ml-btn ml-btn--primary ml-mt-m" href="/technical">Про техническое задание <span class="ml-arrow">→</span></a>
            </div>
            <div class="ml-rows pg-price-factors" data-reveal-stagger>
                <div class="ml-row">
                    <span class="ml-row__num">01</span>
                    <h3 class="ml-row__title">Платформы</h3>
                    <p class="ml-row__desc">Только iOS, только Android или обе платформы сразу.</p>
                </div>
                <div class="ml-row">
                    <span class="ml-row__num">02</span>
                    <h3 class="ml-row__title">Число экранов</h3>
                    <p class="ml-row__desc">Чем больше экранов и сценариев, тем больше работы по дизайну и разработке.</p>
                </div>
                <div class="ml-row">
                    <span class="ml-row__num">03</span>
                    <h3 class="ml-row__title">Интеграции и backend</h3>
                    <p class="ml-row__desc">API, CRM, платежи, собственный сервер и админка.</p>
                </div>
                <div class="ml-row">
                    <span class="ml-row__num">04</span>
                    <h3 class="ml-row__title">Дизайн</h3>
                    <p class="ml-row__desc">Типовые компоненты или индивидуальный UX/UI под бренд.</p>
                </div>
                <div class="ml-row">
                    <span class="ml-row__num">05</span>
                    <h3 class="ml-row__title">Функции</h3>
                    <p class="ml-row__desc">Чат, пользовательский контент, модерация, личные кабинеты.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="ml-section">
    <div class="ml-container">
        <div class="ml-split">
            <div>
                <p class="ml-eyebrow">FAQ</p>
                <h2 class="ml-h2">Вопросы о&nbsp;ценах и&nbsp;сроках</h2>
            </div>
            <div class="ml-faq" data-reveal>
                <details>
                    <summary>Сколько стоит простое приложение или MVP?</summary>
                    <div>Тариф «Простое» (MVP, визитка) — до 500 000 ₽. В него входят стартовый экран, каталог или услуги, контакты и раздел «О компании», push-уведомления и личный кабинет.</div>
                </details>
                <details>
                    <summary>Сколько времени занимает разработка?</summary>
                    <div>Ориентиры по тарифам: «Простое» — до 2 месяцев, «Среднее» — 3–6 месяцев, «Сложное» — 6–12 месяцев и больше.</div>
                </details>
                <details>
                    <summary>Что входит в тариф «Среднее»?</summary>
                    <div>10–20 экранов, поиск, фильтры и комментарии, личный кабинет и админка, API и интеграции, push-уведомления. Стоимость — до 1 200 000 ₽.</div>
                </details>
                <details>
                    <summary>Сколько стоит маркетплейс или соцсеть?</summary>
                    <div>От 3 000 000 ₽. Это 20+ экранов с индивидуальным дизайном, платежи и безопасные транзакции, чат, пользовательский контент и модерация, собственный backend и API, поддержка 10k+ пользователей.</div>
                </details>
                <details>
                    <summary>Как получить точную оценку?</summary>
                    <div>Оставьте заявку на странице <a class="ml-link" href="/contact">контактов</a> или позвоните по номеру <a class="ml-link" href="tel:+79081209023">+7 (908) 120-90-23</a> — обсудим задачу и рассчитаем стоимость под ваш проект.</div>
                </details>
            </div>
        </div>
    </div>
</section>

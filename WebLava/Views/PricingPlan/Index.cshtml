@{
    ViewData["Title"] = "Тарифный план | Разработка мобильных приложений";
    ViewData["ActivePage"] = "pricingplan";
    ViewData["Description"] = "Выберите подходящий тарифный план для разработки мобильного приложения: MVP, каталог или сложные решения. Прозрачные цены и сроки реализации.";
}

<!-- Header  -->
<div class="sub-banner sub-banner4">
    <figure class="sub-bannerleftlayer mb-0">
        <img src="~/images/sub-bannerleftlayer.png" alt="" class="img-fluid">
    </figure>
    @Html.Partial("Menu");
    <section class="banner-section">
        <div class="container">
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                    <div class="banner_content" data-aos="fade-up">
                        <figure class="service-rightcircle mb-0">
                            <img src="~/images/service-rightcircle.png" alt="" class="img-fluid">
                        </figure>
                        <h1 class="text-white">Тарифный план</h1>
                        <p>Технологии, которые окупаются</p>
                        <div class="box">
                            <span class="mb-0">Главная</span>
                            <figure class="mb-0 arrow"><img src="~/images/button-arrow.png" alt="" class="img-fluid"></figure>
                            <span class="mb-0 box_span">Цены</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <figure class="banner-circleright mb-0">
        <img src="~/images/banner-circleright.png" class="img-fluid" alt="">
    </figure>
    <figure class="sub-bannerrightlayer mb-0">
        <img src="~/images/sub-bannerrightlayer.png" alt="" class="img-fluid">
    </figure>
</div>

<section class="pricing-section">
    <figure class="offer-toplayer mb-0">
        <img src="./assets/images/offer-toplayer.png" alt="" class="img-fluid">
    </figure>
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="pricing_content" data-aos="fade-up">
                    <h6>Лучшие предложения</h6>
                    <h2>Наши тарифные планы</h2>
                    <p>
                        Выберите идеальный вариант под ваши задачи — мы сделали цены прозрачными, а возможности — безграничными.
                    </p>
                    <figure class="offer-circleimage mb-0">
                        <img src="./assets/images/offer-circleimage.png" alt="" class="img-fluid">
                    </figure>
                </div>
            </div>
        </div>
        <div class="price-block">
            <div class="row">
                <div class="col-lg-4 col-md-4 col-sm-6 col-12 mb-md-0 mb-4">
                    <div class="price_content">
                        <div class="icon">
                            <figure class="price-basicicon">
                                <img src="~/images/price-basicicon.png" alt="" class="img-fluid">
                            </figure>
                        </div>
                        <h4>Простое</h4>
                        <h4>(MVP, визитка)</h4>
                        <span class="text1">до 500 000 ₽</span>
                        <ul class="list-unstyled mb-0">
                            <li class="text-size-18"><i class="circle fa-duotone fa-check"></i>Стартовый экран</li>                            
                            <li class="text-size-18"><i class="circle fa-duotone fa-check"></i>Каталог / Услуги</li>
                            <li class="text-size-18"><i class="circle fa-duotone fa-check"></i>Контакты / О компании</li>
                            <li class="text-size-18"><i class="circle fa-duotone fa-check"></i>Push-уведомления</li>
                            <li class="text-size-18"><i class="circle fa-duotone fa-check"></i>Личный кабинет</li>                            
                            <li class="for-space text-size-18"><i class="circle fa-duotone fa-check"></i>Срок: до 2 мес.</li>
                        </ul>
                        <a class="get_started text-decoration-none" href="/contact">
                            Заказать расчет
                            <i class="circle fa-thin fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
                <div class="col-lg-4 col-md-4 col-sm-6 col-12 mb-md-0 mb-4">
                    <div class="price_content">
                        <div class="icon">
                            <figure class="price-silvericon">
                                <img src="~/images/price-silvericon.png" alt="" class="img-fluid">
                            </figure>
                        </div>
                        <h4>Среднее</h4>
                        <h4>(каталог, блог)</h4>
                        <span class="text1">до 1 200 000 ₽</span>
                        <ul class="list-unstyled mb-0">
                            <li class="text-size-18"><i class="circle fa-duotone fa-check"></i>10–20 экранов</li>
                            <li class="text-size-18"><i class="circle fa-duotone fa-check"></i>Поиск, фильтры, комментарии</li>
                            <li class="text-size-18"><i class="circle fa-duotone fa-check"></i>Личный кабинет + админка</li>
                            <li class="text-size-18"><i class="circle fa-duotone fa-check"></i>API + интеграции</li>
                            <li class="text-size-18"><i class="circle fa-duotone fa-check"></i>Push-уведомления</li>
                            <li class="for-space text-size-18"><i class="circle fa-duotone fa-check"></i>Срок: 3–6 мес.</li>
                        </ul>
                        <a class="get_started text-decoration-none" href="/contact">
                            Заказать расчет
                            <i class="circle fa-thin fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
                <div class="col-lg-4 col-md-4 col-sm-6 col-12">
                    <div class="price_content">
                        <div class="icon">
                            <figure class="price-goldicon">
                                <img src="~/images/price-goldicon.png" alt="" class="img-fluid">
                            </figure>
                        </div>
                        <h4>Сложное</h4>
                        <h4>(маркетплейс, соцсеть)</h4>
                        <span class="text1">3 000 000+ ₽</span>
                        <ul class="list-unstyled mb-0">
                            <li class="text-size-18"><i class="circle fa-duotone fa-check"></i> 20+ экранов с индив. дизайном</li>
                            <li class="text-size-18"><i class="circle fa-duotone fa-check"></i>Платежи + безоп. транзакции</li>
                            <li class="text-size-18"><i class="circle fa-duotone fa-check"></i>Чат, UGC, модерация контента</li>
                            <li class="text-size-18"><i class="circle fa-duotone fa-check"></i>Свой backend и API</li>
                            <li class="text-size-18"><i class="circle fa-duotone fa-check"></i>Поддержка 10k+ пользователей</li>                            
                            <li class="for-space text-size-18"><i class="circle fa-duotone fa-check"></i>Срок: 6–12+ мес.</li>
                        </ul>
                        <a class="get_started text-decoration-none" href="/contact">
                            Заказать расчет
                            <i class="circle fa-thin fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <figure class="offer-bottomlayer mb-0">
        <img src="./assets/images/offer-bottomlayer.png" alt="" class="img-fluid">
    </figure>
</section>

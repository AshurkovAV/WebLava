    ViewData["Keywords"] = "MVP мобильного приложения, разработка MVP, минимальный жизнеспособный продукт, проверить бизнес идею, дешево разработать приложение, MVP приложение стоимость";
    ViewData["ActivePage"] = "mvp-app";
    ViewData["OgImage"] = "https://biglv.ru/images/post/og-mvp.jpg";

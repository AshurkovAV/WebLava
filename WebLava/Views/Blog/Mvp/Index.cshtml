                                    <a href="#">Мобильные приложения</a>
                                    <a href="#">MVP</a>
                                    <a href="#">Стартапы</a>
                                    <a href="#">Бизнес</a>
                                </div>

                                <!-- Комментарии и форма остаются без изменений -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

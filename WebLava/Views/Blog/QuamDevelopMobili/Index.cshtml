@{
    ViewData["Title"] = "Сколько стоит разработка приложения для бизнеса";
    ViewData["ActivePage"] = "stat2";
    ViewData["Description"] = "Полное руководство по стоимости разработки мобильного приложения для бизнеса в 2025 году. Разбор всех факторов ценообразования, сравнение технологий и практические советы по экономии.";
    ViewData["Keywords"] = "стоимость разработки приложения, цена мобильного приложения, создание приложения для бизнеса, расчет стоимости приложения";
}

<!-- Header  -->

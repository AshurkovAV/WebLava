@{
    ViewData["Title"] = "Блог о разработке мобильных приложений | Big Lava";
    ViewData["ActivePage"] = "blog";
    ViewData["Description"] = "Читайте наш блог о разработке мобильных приложений. Узнайте, как создать успешное приложение, избежать ошибок и оценить стоимость разработки.";
}

@section Head {
    <style>
        .pg-blog-list .ml-post--featured .ml-post__meta { margin-top: 0; }
        .pg-blog-list .ml-post--featured .ml-post__excerpt { font-size: 18px; margin-top: 16px; }
        .pg-blog-list .ml-post__meta { flex-wrap: wrap; }
        .pg-blog-list .ml-posts { margin-top: clamp(56px, 7vw, 112px); padding-top: clamp(40px, 5vw, 72px); border-top: 1px solid var(--ml-line); }
    </style>
}

<div class="pg-blog-list">
    <section class="ml-page-hero">
        <div class="ml-container">
            <nav class="ml-breadcrumbs" aria-label="Хлебные крошки">
                <a href="/">Главная</a><span aria-hidden="true">/</span><span aria-current="page">Блог</span>
            </nav>
            <p class="ml-eyebrow" data-reveal>Журнал Big Lava</p>
            <h1 class="ml-display" data-reveal>Блог</h1>
            <p class="ml-lead" data-reveal>Статьи и руководства по созданию успешных мобильных приложений</p>
        </div>
    </section>

    <section class="ml-section ml-section--tight ml-mt-0" style="padding-top: 0;">
        <div class="ml-container">
            <a data-reveal class="ml-post ml-post--featured" href="/singlepost">
                    <div class="ml-post__media">
                        <img src="/images/post/og-singlepost.jpg" alt="Разработка успешного мобильного приложения: от идеи до запуска" width="1200" height="630">
                    </div>
                    <div class="ml-post__body">
                        <div class="ml-post__meta"><span class="ml-tag">Разработка</span><span><time datetime="2025-01-21">21 января, 2025</time> · 9 мин чтения</span></div>
                        <h2 class="ml-post__title">Разработка успешного мобильного приложения: от идеи до запуска</h2>
                        <p class="ml-post__excerpt">В этом посте мы рассказываем, каковы ключи к разработке успешного мобильного приложения.</p>
                        <span class="ml-link ml-mt-m">Читать статью <span class="ml-arrow">→</span></span>
                    </div>
                </a>

            <div class="ml-posts" data-reveal-stagger>
            <a class="ml-post" href="/QuamDevelopMobili" data-reveal>
                    <div class="ml-post__media">
                        <img src="/images/post/og-quamdevelopmobili.jpg" alt="Сколько стоит разработка приложения для бизнеса?" width="1200" height="630">
                    </div>
                    <div class="ml-post__body">
                        <div class="ml-post__meta"><span class="ml-tag">Разработка</span><span><time datetime="2025-02-28">28 февраля, 2025</time> · 8 мин чтения</span></div>
                        <h2 class="ml-post__title">Сколько стоит разработка приложения для бизнеса?</h2>
                        <p class="ml-post__excerpt">Разработка мобильного приложения для бизнеса — это инвестиция, которая может значительно увеличить доход компании.</p>
                    </div>
                </a>
            <a class="ml-post" href="/blog/devandroid" data-reveal>
                    <div class="ml-post__media">
                        <img src="/images/post/og-devandroid.jpg" alt="Стоимость разработки Android-приложения в 2024 году" width="1200" height="630">
                    </div>
                    <div class="ml-post__body">
                        <div class="ml-post__meta"><span class="ml-tag">Разработка</span><span><time datetime="2024-12-16">16 декабря, 2024</time> · 3 мин чтения</span></div>
                        <h2 class="ml-post__title">Стоимость разработки Android-приложения в 2024 году</h2>
                        <p class="ml-post__excerpt">Подробный анализ стоимости разработки мобильного приложения для Android: из чего складывается цена.</p>
                    </div>
                </a>
            <a class="ml-post" href="/blog/mvp" data-reveal>
                    <div class="ml-post__media">
                        <img src="/images/post/og-mvp.jpg" alt="MVP мобильного приложения: как проверить идею с минимальным бюджетом" width="1200" height="630">
                    </div>
                    <div class="ml-post__body">
                        <div class="ml-post__meta"><span class="ml-tag">Разработка</span><span><time datetime="2026-09-20">20 сентября, 2026</time> · 4 мин чтения</span></div>
                        <h2 class="ml-post__title">MVP мобильного приложения: как проверить идею с минимальным бюджетом</h2>
                        <p class="ml-post__excerpt">Как проверить бизнес-идею через MVP мобильного приложения: что это, из чего состоит и сколько стоит.</p>
                    </div>
                </a>
            </div>
        </div>
    </section>
</div>

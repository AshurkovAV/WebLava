                                    </div>
                                    <div class="pricing-tier popular">
                                        <h3>Стартап</h3>
                                        <div class="price">300 000 – 800 000 ₽</div>
                                        <ul>
                                            <li>Кастомный дизайн</li>
                                            <li>Базовые интеграции</li>
                                            <li>Простой бэкенд</li>

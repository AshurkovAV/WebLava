@{
    ViewData["Title"] = "Разработка мобильных приложений на аутсорсе | Big Lava";
    ViewData["Description"] = "Студия Big Lava (Курск) разрабатывает мобильные приложения для iOS и Android под ключ: от MVP до сложных систем. UX/UI-дизайн, ТЗ, frontend и backend. Обсудим ваш проект.";
    ViewData["ActivePage"] = "home";
}

@section Head {
    <style>
        .pg-home-shot { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }
        .pg-home-shot img {
            height: 88%; width: auto; max-width: none; border-radius: 26px; border: 1px solid rgba(255,255,255,.18);
            box-shadow: 0 40px 80px rgba(0,0,0,.55); transition: transform 1s var(--ml-ease);
        }
        .ml-case:hover .pg-home-shot img { transform: translateY(-8px) rotate(-2deg); }
        .pg-home-shot--offset { justify-content: flex-end; padding-right: 12%; }
        .pg-home-cover-title { position: absolute; left: clamp(20px, 4vw, 56px); top: 50%; transform: translateY(-50%); max-width: 44%; }
        .pg-home-cover-title span { display: block; font-family: var(--ml-display); font-size: clamp(28px, 3.6vw, 56px); font-weight: 600; letter-spacing: -.04em; line-height: 1.02; }
        .pg-home-cover-title small { display: block; margin-top: 14px; font-size: 13px; letter-spacing: .14em; text-transform: uppercase; color: rgba(255,255,255,.6); }
        @@media (max-width: 760px) {
            .pg-home-shot--offset { justify-content: center; padding-right: 0; }
            .pg-home-cover-title { display: none; }
        }
        .pg-home-about { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(32px, 6vw, 96px); align-items: end; margin-bottom: clamp(48px, 6vw, 88px); }
        .pg-home-about__big { font-family: var(--ml-display); font-size: clamp(96px, 16vw, 240px); font-weight: 600; letter-spacing: -.06em; line-height: .85; }
        .pg-home-about__big sup { font-size: .4em; color: var(--ml-accent); vertical-align: top; }
        .pg-home-about__cap { margin-top: 16px; color: #55524d; }
        @@media (max-width: 1024px) { .pg-home-about { grid-template-columns: 1fr; } }
        .ml-section--light .ml-card__icon svg { width: 24px; height: 24px; }
        .pg-home-teasers { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--ml-line); }
        .pg-home-teaser { padding: 32px 32px 32px 0; border-bottom: 1px solid var(--ml-line); display: flex; flex-direction: column; gap: 10px; }
        .pg-home-teaser + .pg-home-teaser { padding-left: 32px; border-left: 1px solid var(--ml-line); }
        .pg-home-teaser__name { font-size: 24px; }
        .pg-home-teaser__for { color: var(--ml-muted); font-size: 15px; }
        .pg-home-teaser__value { font-family: var(--ml-display); font-size: clamp(32px, 3.2vw, 48px); font-weight: 600; letter-spacing: -.04em; line-height: 1; margin-top: 24px; }
        .pg-home-teaser__term { color: var(--ml-muted); font-size: 15px; }
        .pg-home-teaser--featured .pg-home-teaser__value { color: var(--ml-accent); }
        @@media (max-width: 860px) {
            .pg-home-teasers { grid-template-columns: 1fr; }
            .pg-home-teaser, .pg-home-teaser + .pg-home-teaser { padding: 28px 0; border-left: 0; }
        }
    </style>
}


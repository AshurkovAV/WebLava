@{
    ViewData["Title"] = "UX/UI-дизайн мобильных приложений | Big Lava";
    ViewData["Description"] = "Разрабатываем удобные и красивые UX/UI-интерфейсы мобильных приложений для бизнеса: прототипирование, дизайн-макеты, тестирование юзабилити.";
    ViewData["ActivePage"] = "design";
}

<!-- Header  -->
<div class="sub-banner sub-banner4">
    <figure class="sub-bannerleftlayer mb-0">
        <img src="~/images/sub-bannerleftlayer.png" alt="" class="img-fluid">
    </figure>
    @Html.Partial("Menu");
    <section class="banner-section">
        <div class="container">
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                    <div class="banner_content" data-aos="fade-up">
                        <figure class="service-rightcircle mb-0">
                            <img src="~/images/service-rightcircle.png" alt="" class="img-fluid">
                        </figure>
                        <h1 class="text-white">UX/UI-дизайн</h1>
                        <p>Разрабатываем удобные и красивые интерфейсы для вашего бизнеса</p>
                        <div class="box">
                            <span class="mb-0">Главная</span>
                            <figure class="mb-0 arrow"><img src="~/images/button-arrow.png" alt="" class="img-fluid"></figure>
                            <span class="mb-0 box_span">Услуги</span>
                            <figure class="mb-0 arrow"><img src="~/images/button-arrow.png" alt="" class="img-fluid"></figure>
                            <span class="mb-0 box_span">UX/UI-дизайн</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <figure class="banner-circleright mb-0">
        <img src="~/images/banner-circleright.png" class="img-fluid" alt="">
    </figure>
    <figure class="sub-bannerrightlayer mb-0">
        <img src="~/images/sub-bannerrightlayer.png" alt="" class="img-fluid">
    </figure>
</div>

<section class="servicepage-section service-section">
    <figure class="service-leftlayer mb-0">
        <img src="~/images/service-leftlayer.png" alt="" class="img-fluid">
    </figure>
    <figure class="service-dotimage mb-0">
        <img src="~/images/service-dotimage.png" alt="" class="img-fluid">
    </figure>
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="servicepage_content" data-aos="fade-right">
                    <h6>Наши услуги</h6>
                    <h2>Профессиональный UX/UI-дизайн</h2>
                    <p>
                        Создаем интуитивно понятные и эстетичные интерфейсы, которые повышают вовлеченность пользователей и решают бизнес-задачи.
                    </p>
                    <figure class="offer-circleimage mb-0">
                        <img src="~/images/offer-circleimage.png" alt="" class="img-fluid">
                    </figure>
                </div>
            </div>
        </div>
        <div class="service_contentbox">
            <div class="row">
                <div class="owl-carousel owl-theme">
                    <div class="item">
                        <div class="service-box box-mb">
                            <figure class="service-designicon">
                                <img src="~/images/service-designicon.png" alt="Иконка услуги «Мобильные интерфейсы»" class="img-fluid">
                            </figure>
                            <h4>Мобильные интерфейсы</h4>
                            <p class="text-size-18">Дизайн приложений для iOS и Android с учетом гайдлайнов</p>
                            <a class="arrow text-decoration-none" href="#"><i class="circle fa-thin fa-arrow-right"></i></a>
                        </div>
                    </div>
                    <div class="item">
                        <div class="service-box box-mb">
                            <figure class="service-designicon">
                                <img src="~/images/service-designicon.png" alt="Иконка услуги «Веб-интерфейсы»" class="img-fluid">
                            </figure>
                            <h4>Веб-интерфейсы</h4>
                            <p class="text-size-18">Современный дизайн сайтов, SaaS и админ-панелей</p>
                            <a class="arrow text-decoration-none" href="#"><i class="circle fa-thin fa-arrow-right"></i></a>
                        </div>
                    </div>
                    <div class="item">
                        <div class="service-box">
                            <figure class="service-designicon">
                                <img src="~/images/service-designicon.png" alt="Иконка услуги «UX-исследования»" class="img-fluid">
                            </figure>
                            <h4>UX-исследования</h4>
                            <p class="text-size-18">Анализ пользователей и проектирование CJM</p>
                            <a class="arrow text-decoration-none" href="#"><i class="circle fa-thin fa-arrow-right"></i></a>
                        </div>
                    </div>
                    <div class="item">
                        <div class="service-box">
                            <figure class="service-designicon">
                                <img src="~/images/service-designicon.png" alt="Иконка услуги «Прототипирование»" class="img-fluid">
                            </figure>
                            <h4>Прототипирование</h4>
                            <p class="text-size-18">Создание интерактивных прототипов и user flow</p>
                            <a class="arrow text-decoration-none" href="#"><i class="circle fa-thin fa-arrow-right"></i></a>
                        </div>
                    </div>
                    <div class="item">
                        <div class="service-box box-mb">
                            <figure class="service-designicon">
                                <img src="~/images/service-designicon.png" alt="Иконка услуги «Дизайн-системы»" class="img-fluid">
                            </figure>
                            <h4>Дизайн-системы</h4>
                            <p class="text-size-18">Комплексные решения для масштабирования продукта</p>
                            <a class="arrow text-decoration-none" href="#"><i class="circle fa-thin fa-arrow-right"></i></a>
                        </div>
                    </div>
                    <div class="item">
                        <div class="service-box box-mb">
                            <figure class="service-designicon">
                                <img src="~/images/service-designicon.png" alt="Иконка услуги «Брендинг в UI»" class="img-fluid">
                            </figure>
                            <h4>Брендинг в UI</h4>
                            <p class="text-size-18">Фирменный стиль для цифровых продуктов</p>
                            <a class="arrow text-decoration-none" href="#"><i class="circle fa-thin fa-arrow-right"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Дополнительный блок с описанием -->
        <div class="row mt-5">
            <div class="col-lg-6 col-md-6 col-sm-12 col-12">
                <div class="service-detail" data-aos="fade-up">
                    <h3>Наш подход к дизайну</h3>
                    <p>Мы сочетаем эстетику с функциональностью, создавая интерфейсы, которые:</p>
                    <ul>
                        <li>Увеличивают конверсию и удержание пользователей</li>
                        <li>Соответствуют современным трендам и стандартам</li>
                        <li>Учитывают особенности вашей целевой аудитории</li>
                        <li>Решают конкретные бизнес-задачи</li>
                    </ul>
                </div>
            </div>
            <div class="col-lg-6 col-md-6 col-sm-12 col-12">
                <div class="service-process" data-aos="fade-up">
                    <h3>Процесс работы</h3>
                    <div class="process-step">
                        <span>1</span>
                        <p>Анализ требований и исследование ЦА</p>
                    </div>
                    <div class="process-step">
                        <span>2</span>
                        <p>Прототипирование и user flow</p>
                    </div>
                    <div class="process-step">
                        <span>3</span>
                        <p>Разработка визуального дизайна</p>
                    </div>
                    <div class="process-step">
                        <span>4</span>
                        <p>Тестирование и доработка</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <figure class="service-rightlayer mb-0">
        <img src="~/images/service-rightlayer.png" alt="" class="img-fluid">
    </figure>
</section>
@model WebLava.Models.ContactFormModel
@{
    ViewData["Title"] = "Контакты — обсудить проект | Big Lava";
    ViewData["ActivePage"] = "contact";
    ViewData["Description"] = "Расскажите о проекте мобильного приложения: +7 (908) 120-90-23, ashurkovav@yandex.ru. Big Lava, г. Курск, ул. Радищева, 64. Ответим с оценкой сроков.";
    ViewData["HideCta"] = true;
}

@section Head {
    <style>
        .pg-contact { padding: clamp(140px, 16vw, 200px) 0 clamp(72px, 10vw, 140px); position: relative; overflow: hidden; }
        .pg-contact .ml-hero__glow { right: auto; left: -360px; top: -380px; }
        .pg-contact__grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: clamp(40px, 7vw, 120px); align-items: start; position: relative; z-index: 1; }
        .pg-contact__title { font-size: clamp(48px, 7.4vw, 124px); line-height: .96; letter-spacing: -.05em; font-weight: 600; }
        .pg-contact__list { list-style: none; margin-top: clamp(40px, 5vw, 72px); border-top: 1px solid var(--ml-line); }
        .pg-contact__list li { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 16px; padding: 22px 0; border-bottom: 1px solid var(--ml-line); align-items: baseline; }
        .pg-contact__list dt, .pg-contact__label { font-size: 13px; letter-spacing: .12em; text-transform: uppercase; color: var(--ml-muted-2); }
        .pg-contact__value { font-family: var(--ml-display); font-size: clamp(20px, 1.8vw, 26px); letter-spacing: -.015em; line-height: 1.3; display: grid; gap: 6px; }
        .pg-contact__value a { transition: color .2s; overflow-wrap: anywhere; }
        .pg-contact__value a:hover { color: var(--ml-accent); }
        .pg-contact__value small { font-family: var(--ml-font); font-size: 15px; letter-spacing: 0; }
        .pg-contact__form { background: var(--ml-surface); border: 1px solid var(--ml-line); border-radius: var(--ml-radius-lg); padding: clamp(24px, 3.4vw, 52px); }
        .pg-contact__form .ml-h3 { margin-bottom: 8px; }
        .pg-contact__form fieldset { border: 0; margin: 0; padding: 0; display: grid; gap: 12px; }
        .pg-contact__form legend { font-size: 14px; color: var(--ml-muted); margin-bottom: 12px; padding: 0; }
        .pg-contact__submit { justify-self: start; }
        .pg-contact__submit[disabled] { opacity: .6; cursor: progress; transform: none; }
        .pg-contact__note { font-size: 14px; color: var(--ml-muted-2); margin: 0; }
        .pg-contact__alert { display: none; }
        .pg-contact__alert.is-shown { display: block; }
        .pg-contact__alert strong { display: block; margin-bottom: 2px; }
        .input-validation-error { border-bottom-color: #ff7a6b !important; }
        @@media (max-width: 1024px) { .pg-contact__grid { grid-template-columns: 1fr; } }
        @@media (max-width: 560px) { .pg-contact__list li { grid-template-columns: 1fr; gap: 6px; } .pg-contact__submit { width: 100%; } }
    </style>
}

<section class="pg-contact">
    <div class="ml-hero__glow" aria-hidden="true"></div>
    <div class="ml-container">
        <div class="pg-contact__grid">
            <div>
                <nav class="ml-breadcrumbs" aria-label="Хлебные крошки">
                    <a href="/">Главная</a><span aria-hidden="true">/</span><span>Контакты</span>
                </nav>
                <p class="ml-eyebrow">Контакты</p>
                <h1 class="pg-contact__title" data-reveal>Расскажите о&nbsp;<span class="ml-gradient-text">проекте</span></h1>
                <p class="ml-lead ml-mt-m" data-reveal>
                    Здесь можно обсудить проект, сотрудничество и финансовые вопросы. Напишите пару строк о задаче — вернёмся с вопросами и оценкой сроков.
                </p>

                <ul class="pg-contact__list" data-reveal-stagger>
                    <li>
                        <span class="pg-contact__label">Телефон</span>
                        <span class="pg-contact__value">
                            <a href="tel:+79081209023">+7 (908) 120-90-23</a>
                            <a href="tel:+79308531417">+7 (930) 853-14-17</a>
                        </span>
                    </li>
                    <li>
                        <span class="pg-contact__label">Email</span>
                        <span class="pg-contact__value"><a href="mailto:ashurkovav@yandex.ru">ashurkovav@yandex.ru</a></span>
                    </li>
                    <li>
                        <span class="pg-contact__label">Telegram</span>
                        <span class="pg-contact__value"><a href="https://t.me/ashurkovav" target="_blank" rel="noopener">@@ashurkovav</a></span>
                    </li>
                    <li>
                        <span class="pg-contact__label">Адрес</span>
                        <span class="pg-contact__value">
                            <span>305004, г. Курск, ул. Радищева, 64</span>
                            <small><a class="ml-link" href="https://yandex.ru/maps/?text=%D0%9A%D1%83%D1%80%D1%81%D0%BA%2C%20%D1%83%D0%BB.%20%D0%A0%D0%B0%D0%B4%D0%B8%D1%89%D0%B5%D0%B2%D0%B0%2C%2064" target="_blank" rel="noopener">Открыть на Яндекс Картах <span class="ml-arrow">↗</span></a></small>
                        </span>
                    </li>
                </ul>
            </div>

            <div class="pg-contact__form" data-reveal>
                <h2 class="ml-h3">Напишите нам</h2>
                <p class="ml-muted">Все поля обязательны. Выбор типа проекта и бюджета — по желанию.</p>

                @{ var successMessage = TempData["SuccessMessage"]?.ToString(); }
                <div id="contactAlert" class="ml-alert pg-contact__alert ml-mt-s@(successMessage != null ? " is-shown" : "")" role="status" aria-live="polite">
                    <strong id="contactAlertTitle">@(successMessage != null ? "Успешно!" : "")</strong>
                    <span id="contactAlertMessage">@successMessage</span>
                </div>

                <form id="contactForm" class="ml-form ml-mt-m" method="POST" asp-controller="Contact" asp-action="SubmitForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="ml-field-error"></div>

                    <fieldset>
                        <legend>Тип проекта</legend>
                        <div class="ml-chips">
                            <label class="ml-chip"><input type="radio" name="pgProjectType" value="Мобильное приложение"><span>Мобильное приложение</span></label>
                            <label class="ml-chip"><input type="radio" name="pgProjectType" value="MVP"><span>MVP</span></label>
                            <label class="ml-chip"><input type="radio" name="pgProjectType" value="UX/UI-дизайн"><span>UX/UI-дизайн</span></label>
                            <label class="ml-chip"><input type="radio" name="pgProjectType" value="Техническое задание"><span>Техническое задание</span></label>
                            <label class="ml-chip"><input type="radio" name="pgProjectType" value="ИИ-агент"><span>ИИ-агент</span></label>
                        </div>
                    </fieldset>

                    <fieldset>
                        <legend>Бюджет</legend>
                        <div class="ml-chips">
                            <label class="ml-chip"><input type="radio" name="pgBudget" value="до 500 000 ₽"><span>до 500 000 ₽</span></label>
                            <label class="ml-chip"><input type="radio" name="pgBudget" value="до 1 200 000 ₽"><span>до 1 200 000 ₽</span></label>
                            <label class="ml-chip"><input type="radio" name="pgBudget" value="3 000 000+ ₽"><span>3 000 000+ ₽</span></label>
                            <label class="ml-chip"><input type="radio" name="pgBudget" value="Пока не знаю"><span>Пока не знаю</span></label>
                        </div>
                    </fieldset>

                    <div class="ml-field">
                        <label asp-for="Name">Ваше имя</label>
                        <input asp-for="Name" class="ml-input" type="text" placeholder="Как к вам обращаться" autocomplete="name">
                        <span asp-validation-for="Name" class="ml-field-error"></span>
                    </div>
                    <div class="ml-field">
                        <label asp-for="Emailid">Email</label>
                        <input asp-for="Emailid" class="ml-input" type="email" placeholder="you@company.ru" autocomplete="email">
                        <span asp-validation-for="Emailid" class="ml-field-error"></span>
                    </div>
                    <div class="ml-field">
                        <label asp-for="Msg">О проекте</label>
                        <textarea asp-for="Msg" class="ml-textarea" rows="4" placeholder="Какую задачу должно решать приложение, есть ли сроки"></textarea>
                        <span asp-validation-for="Msg" class="ml-field-error"></span>
                    </div>

                    <button type="submit" id="submitButton" class="ml-btn ml-btn--accent ml-btn--lg pg-contact__submit">
                        <span class="pg-contact__submit-text">Отправить</span> <span class="ml-arrow">→</span>
                    </button>
                    <p class="pg-contact__note">Нажимая «Отправить», вы передаёте имя, email и сообщение для ответа на заявку.</p>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(function () {
            var $form = $('#contactForm');
            var $btn = $('#submitButton');
            var $btnText = $btn.find('.pg-contact__submit-text');
            var $alert = $('#contactAlert');
            var hideTimer = null;

            // Уведомление через ml-alert
            function showNotification(title, message, type) {
                $('#contactAlertTitle').text(title);
                $('#contactAlertMessage').text(message);
                $alert.toggleClass('ml-alert--error', type === 'error').addClass('is-shown');
                clearTimeout(hideTimer);
                hideTimer = setTimeout(function () { $alert.removeClass('is-shown'); }, 7000);
            }

            // Тип проекта и бюджет подмешиваются в поле Msg (модель не меняется)
            function buildData() {
                var arr = $form.serializeArray();
                var type = $form.find('input[name="pgProjectType"]:checked').val();
                var budget = $form.find('input[name="pgBudget"]:checked').val();
                var prefix = [];
                if (type) prefix.push('Тип проекта: ' + type);
                if (budget) prefix.push('Бюджет: ' + budget);
                return $.map(arr, function (f) {
                    if (f.name === 'pgProjectType' || f.name === 'pgBudget') return null;
                    if (f.name === 'Msg' && prefix.length) f = { name: 'Msg', value: prefix.join('\n') + '\n\n' + f.value };
                    return f;
                });
            }

            $form.on('submit', function (e) {
                e.preventDefault();
                if ($.fn.valid && !$form.valid()) return;

                $btn.prop('disabled', true);
                $btnText.text('Отправка…');

                $.ajax({
                    url: $form.attr('action'),
                    type: 'POST',
                    data: $.param(buildData()),
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (response) {
                        if (response && response.success) {
                            showNotification('Успешно!', response.message, 'success');
                            $form[0].reset();
                        } else {
                            showNotification('Ошибка!', (response && response.message) || 'Не удалось отправить сообщение.', 'error');
                        }
                    },
                    error: function () {
                        showNotification('Ошибка!', 'Произошла ошибка при отправке формы.', 'error');
                    },
                    complete: function () {
                        $btn.prop('disabled', false);
                        $btnText.text('Отправить');
                    }
                });
            });

        });
    </script>
}

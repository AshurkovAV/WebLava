@{
    ViewData["Title"] = "Контакты | Обсудить проект и сотрудничество";
    ViewData["ActivePage"] = "contact";
    ViewData["Description"] = "Контактная информация для обсуждения проектов, сотрудничества и финансовых вопросов. Находимся в Курске по адресу ул. Радищева 64.";

@{
    ViewData["Title"] = "Кейсы разработки мобильных приложений | Big Lava";
    ViewData["Description"] = "Примеры проектов Big Lava: мобильные приложения, MVP и кроссплатформенные решения для бизнеса. Реальные кейсы скоро дополним.";
    ViewData["ActivePage"] = "portfolio";
}

<!-- Header  -->
<div class="sub-banner sub-banner4">
    <figure class="sub-bannerleftlayer mb-0">
        <img src="~/images/sub-bannerleftlayer.png" alt="" class="img-fluid">
    </figure>
    @Html.Partial("Menu");
    <section class="banner-section">
        <div class="container">
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                    <div class="banner_content" data-aos="fade-up">
                        <figure class="service-rightcircle mb-0">
                            <img src="~/images/service-rightcircle.png" alt="" class="img-fluid">
                        </figure>
                        <h1 class="text-white">Кейсы</h1>
                        <p>Проекты, над которыми мы работали</p>
                        <div class="box">
                            <span class="mb-0">Главная</span>
                            <figure class="mb-0 arrow"><img src="~/images/button-arrow.png" alt="" class="img-fluid"></figure>
                            <span class="mb-0 box_span">Кейсы</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <figure class="banner-circleright mb-0">
        <img src="~/images/banner-circleright.png" class="img-fluid" alt="">
    </figure>
    <figure class="sub-bannerrightlayer mb-0">
        <img src="~/images/sub-bannerrightlayer.png" alt="" class="img-fluid">
    </figure>
</div>

<section class="portfolio-section" style="padding: 80px 0;">
    <div class="container">
        <div class="row">
            <div class="col-12" style="margin-bottom: 40px;">
                <p class="text-size-16" style="max-width: 720px;">
                    Здесь собраны реальные проекты Big Lava — мобильные приложения, MVP, кроссплатформенные решения и ИИ-агенты — с конкретными результатами: сроками, стеком и измеримым эффектом для бизнеса. Часть карточек ниже — пока заглушки под структуру, которые постепенно заменим на настоящие кейсы.
                </p>
            </div>
        </div>

        <div class="cards-grid">
            <!-- TODO: добавить название проекта/клиента, платформы, измеримую цифру и целевую страницу кейса, когда появятся -->
            <div class="card-item">
                <div class="card-item-image">
                    <img src="~/images/portfolio/taxi-app-vacancies.jpg" alt="Агрегатор вакансий для таксопарков — мобильное приложение">
                </div>
                <div class="card-item-body">
                    <span class="card-item-badge">Мобильное приложение</span>
                    <h3 class="card-item-title">Агрегатор вакансий для таксопарков</h3>
                    <p class="card-item-result">Приложение для поиска вакансий в таксопарках: карта с поиском по местоположению, лента предложений с откликом в один тап, фильтры по городу и классу автомобиля, карточка автомобиля с условиями аренды.</p>
                    <a class="card-item-link" href="#">Подробнее <i class="fa fa-arrow-right"></i></a>
                </div>
            </div>

            <!-- TODO: заменить на реальный кейс -->
            <div class="card-item">
                <div class="card-item-image">
                    <img src="~/images/post/og-case-mvp.jpg" alt="[Название проекта] — MVP">
                </div>
                <div class="card-item-body">
                    <span class="card-item-badge">MVP</span>
                    <h3 class="card-item-title">[Название проекта]</h3>
                    <p class="card-item-result">[Результат: например, во сколько раз сократили бюджет за счёт MVP-подхода, срок запуска]</p>
                    <a class="card-item-link" href="#">Подробнее <i class="fa fa-arrow-right"></i></a>
                </div>
            </div>

            <!-- TODO: заменить на реальный кейс -->
            <div class="card-item">
                <div class="card-item-image">
                    <img src="~/images/post/og-case-crossplatform.jpg" alt="[Название проекта] — кроссплатформенная разработка">
                </div>
                <div class="card-item-body">
                    <span class="card-item-badge">Кроссплатформа</span>
                    <h3 class="card-item-title">[Название проекта]</h3>
                    <p class="card-item-result">[Результат: например, запуск на iOS и Android с единой кодовой базой, экономия на разработке]</p>
                    <a class="card-item-link" href="#">Подробнее <i class="fa fa-arrow-right"></i></a>
                </div>
            </div>

            <div class="card-item">
                <div class="card-item-image">
                    <img src="~/images/post/og-case-ai-agent.jpg" alt="ЯДРО — ИИ-агент для бизнеса">
                </div>
                <div class="card-item-body">
                    <span class="card-item-badge">Интеграция / ИИ</span>
                    <h3 class="card-item-title">ЯДРО — ИИ-агент для бизнеса</h3>
                    <p class="card-item-result">Один ИИ-агент вместо трёх ботов и команды поддержки — обрабатывает заказы и запись в Telegram, MAX и WhatsApp через единый ИИ-пайплайн с интеграцией amoCRM.</p>
                    <a class="card-item-link" href="/yadro/">Подробнее <i class="fa fa-arrow-right"></i></a>
                </div>
            </div>
        </div>
    </div>
</section>

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    @{
        var currentPath = Context.Request.Path.Value ?? "/";
        var canonicalPath = currentPath == "/" ? "/" : currentPath.TrimEnd('/');
        var ogImage = ViewData["OgImage"] as string ?? "https://biglv.ru/images/logo-og-default.jpg";
    }
    <meta name="description" content="@Html.Raw(ViewData["Description"])" />
    <title>@Html.Raw(ViewData["Title"])</title>
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Big Lava" />
    <meta property="og:title" content="@Html.Raw(ViewData["Title"])" />
    <meta property="og:description" content="@Html.Raw(ViewData["Description"])" />
    <meta property="og:url" content="https://biglv.ru@(canonicalPath)" />
    <meta property="og:image" content="@ogImage" />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- /SEO Ultimate -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#0b0b0c">
    @if (ViewData["Keywords"] != null)
    {
        <meta name="keywords" content="@Html.Raw(ViewData["Keywords"])" />
    }
    <link rel="icon" href="/favicon.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Inter+Tight:wght@500;600;700&display=swap" rel="stylesheet">
    <link href="~/css/ml.css" rel="stylesheet" asp-append-version="true">
    @await RenderSectionAsync("Head", required: false)

    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "ProfessionalService",
          "name": "Big Lava",
          "address": {
            "@@type": "PostalAddress",
            "streetAddress": "ул. Радищева, 64",
            "addressLocality": "Курск",
            "addressRegion": "Курская область",
            "postalCode": "305004",
            "addressCountry": "RU"
          },
          "areaServed": ["Россия", "СНГ"],
          "telephone": "+79081209023",
          "url": "https://biglv.ru/",
          "priceRange": "от 500 000 ₽ до 3 000 000+ ₽",
          "sameAs": []
        }
    </script>
    <link rel="canonical" href="https://biglv.ru@(canonicalPath)" />
    <!-- Yandex.Metrika counter -->
<script type="text/javascript">
    (function (m, e, t, r, i, k, a) {
        m[i] = m[i] || function () { (m[i].a = m[i].a || []).push(arguments) };
        m[i].l = 1 * new Date();
        for (var j = 0; j < document.scripts.length; j++) { if (document.scripts[j].src === r) { return; } }
        k = e.createElement(t), a = e.getElementsByTagName(t)[0], k.async = 1, k.src = r, a.parentNode.insertBefore(k, a)
    })
        (window, document, "script", "https://mc.yandex.ru/metrika/tag.js", "ym");

    ym(101658266, "init", {
        clickmap: true,
        trackLinks: true,
        accurateTrackBounce: true
    });
</script>

<!-- /Yandex.Metrika counter -->
</head>


<body>
    <noscript><div><img src="https://mc.yandex.ru/watch/101658266" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
    <partial name="_Header" />
    <main id="main">
        @RenderBody()
    </main>
    @if (!(ViewData["HideCta"] is bool hide && hide))
    {
        <partial name="_Cta" />
    }
    <partial name="_Footer" />

    <script src="~/js/jquery-3.6.0.min.js"></script>
    <script src="~/js/ml.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html> 
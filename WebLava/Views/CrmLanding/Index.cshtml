@using WebLava.Models.Crm
@{
    Layout = "_CrmLayout";
    ViewData["Title"] = "Продукты Big Lava для малых производств | Big Lava";
    ViewData["Description"] = "Продукты студии Big Lava для малых производств: Bakesoft для кондитерских и Big Lava CRM для мебельных производств. Заказы, себестоимость, производство, склад и закупки.";
    ViewData["Keywords"] = "Big Lava CRM, Bakesoft, CRM для производства, программа для кондитерской, CRM для мебельного производства";
    ViewData["OgImage"] = "https://biglv.ru/images/crm/mebel-deals.png";
    ViewData["CrmNav"] = false;
}

<section class="crm-hero crm-hero--hub" aria-labelledby="hero-title">
    <div class="crm-wrap">
        <span class="crm-chip"><span class="crm-chip__dot" aria-hidden="true"></span>Новый продукт · ранний доступ</span>
        <h1 id="hero-title">Продукты Big Lava для малых производств</h1>
        <p class="crm-hero__sub">Заказы, расчёт себестоимости, план производства, склад и закупки — в продуктах под конкретную нишу. Выберите свой: @CrmPricing.TrialDays дней бесплатно, оплата по СБП.</p>

        <div class="crm-hub">
            <a class="crm-hub__card" href="/bakesoft">
                <div class="crm-window">
                    <img src="/images/bakesoft/orders.jpg" alt="Bakesoft: заказы кондитерской на неделю по дням" width="1440" height="900" fetchpriority="high" style="display:block;width:100%;height:auto">
                </div>
                <h2>Bakesoft — для кондитерских</h2>
                <p>Система управления заказами и производством: техкарты с пересчётом под размер, себестоимость, план производства, закупки и выдача.</p>
                <span class="crm-hub__more">Подробнее →</span>
            </a>
            <a class="crm-hub__card" href="/crm/mebel">
                <div class="crm-window">
                    <partial name="_CrmPicture" model='new CrmImage("mebel-deals", "Канбан сделок мебельного производства в Big Lava CRM", 1600, 1000, Eager: true)' />
                </div>
                <h2>Big Lava CRM — для мебельных производств</h2>
                <p>Расчёт себестоимости изделия и КП, сделки, производство и сроки, склад, закупки и подрядчики.</p>
                <span class="crm-hub__more">Подробнее →</span>
            </a>
        </div>
    </div>
</section>

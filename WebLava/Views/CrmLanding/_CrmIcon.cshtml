@switch (Model)
{
    case "notebook":
        <text><path d="M6 3h11a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6z" /><path d="M6 3v18M4 7h4M4 12h4M4 17h4M10 8h6M10 12h5" /></text>
        break;
    case "scale":
        <text><path d="M12 3v18M5 21h14M7 7h10" /><path d="M7 7l-3 7a3 3 0 0 0 6 0zM17 7l-3 7a3 3 0 0 0 6 0z" /></text>
        break;
    case "ruble":
        <text><circle cx="12" cy="12" r="9" /><path d="M10 17V7h3.2a2.6 2.6 0 0 1 0 5.2H8.5M8.5 14.8h5" /></text>
        break;
    case "cart":
        <text><path d="M3 4h2l2.4 11h10.2L20 8H6.2" /><circle cx="9" cy="19.5" r="1.4" /><circle cx="17" cy="19.5" r="1.4" /></text>
        break;
    case "calc":
        <text><rect x="5" y="3" width="14" height="18" rx="2" /><path d="M8 7h8M8 12h.01M12 12h.01M16 12h.01M8 16h.01M12 16h.01M16 16h.01" /></text>
        break;
    case "deals":
        <text><rect x="3" y="4" width="5" height="16" rx="1.5" /><rect x="10" y="4" width="5" height="11" rx="1.5" /><rect x="17" y="4" width="4" height="7" rx="1.5" /></text>
        break;

        <text><path d="M3 21V10l5 3V10l5 3V5h4l1 16zM3 21h18" /><path d="M7 17h2M12 17h2" /></text>
        break;
    case "box":
        <text><path d="M21 8l-9-5-9 5 9 5zM3 8v8l9 5 9-5V8M12 13v8" /></text>
        break;
    case "team":
        <text><circle cx="9" cy="8" r="3.2" /><path d="M3 20a6 6 0 0 1 12 0M16 4.5a3.2 3.2 0 0 1 0 6.2M18 14a6 6 0 0 1 3 6" /></text>
        break;
    default:
        <text><circle cx="12" cy="12" r="9" /></text>
        break;
}
</svg>
